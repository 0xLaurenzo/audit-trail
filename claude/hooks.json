{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume|clear|compact",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/audit-trail\" claude-hook",
						"timeout": 15,
						"statusMessage": "Recording audit-trail session state..."
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/audit-trail\" claude-hook",
						"timeout": 15
					}
				]
			}
		]
	}
}
