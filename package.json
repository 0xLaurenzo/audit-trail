{
  "name": "pi-audit-trail",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Append-only decision auditing and independent review for the pi coding agent",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "audit-trail",
    "decision-log"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xLaurenzo/audit-trail.git"
  },
  "bin": {
    "audit-trail": "bin/audit-trail"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types --check src/adapters/pi.ts && node --experimental-strip-types --check src/adapters/opencode.ts && node --experimental-strip-types --check src/cli/main.ts && npm test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/adapters/pi.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^26.1.2",
    "typebox": "1.1.38",
    "typescript": "^7.0.2"
  }
}
